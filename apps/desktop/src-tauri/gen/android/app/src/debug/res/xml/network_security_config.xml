<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (replaces src/main/res/xml/network_security_config.xml):
     `tauri android dev` loads the UI from the Vite dev server on the PC over
     plain HTTP. Release builds permit no cleartext at all – keep it that way.
     A unit test in src-tauri/src/gui.rs guards this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
